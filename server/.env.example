# Meridian Capital Partners — backend environment variables
# Copy this file to `.env` (or export these in your shell) before running in production.

# Port the server listens on (default: 3000)
PORT=3000

# Secret used to sign JWTs. MUST be a long random string in production.
JWT_SECRET=change-me-to-a-long-random-string

# Seed admin account (created on first boot only)
ADMIN_EMAIL=admin@meridiancapital.co.uk
ADMIN_PASSWORD=admin123

# NOTE: SMTP (host/port/user/pass/from) and other site settings are configured
# at runtime from the Admin Console → Settings tab, and stored in the database.
